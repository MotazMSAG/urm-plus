        return ""

    def _urmref_chain(first):
        """
        Every gate ahead of the cursor, in the order they are tested.

        The whole chain is collected before any card is built, so the summary
        can say how many gates there really are even when the card list is
        capped.
        """

        steps = []

        # Parallel to steps: (if-statement, arm index) for each, or (None, -1)
        # for the fall-through tail. Kept on URM's constant store, so the
        # force-a-path buttons can name the exact arm without walking again.
        meta = python_list()
        node = first

        for _ in range(_URMREF_MAX_GATES + 4):

            closed = False

            for arm, (cond, block) in enumerate(getattr(node, "entries", None) or []):

                if not _urmref_is_condition(cond):
                    steps.append(("else", None, block))
                    meta.append((node, arm))
                    closed = True
                    break

                steps.append(("gate", cond, block))
                meta.append((node, arm))

            if closed:
                return steps, meta

            following = x52URM.PathDetection.nextNode(node)
            node = None
            ahead = following

            for _ in range(x52URM.PathDetection.lookAheadLimit):
                if ahead is None:
                    break
                if isinstance(ahead, renpy.ast.If):
                    node = ahead
                    break
                if x52URM.PathDetection.nodeIsBlocking(ahead):
                    break
                ahead = x52URM.PathDetection.nextNode(ahead)

            if node is None:
                tail = _urmref_tail(following)
                if tail:
                    steps.append(("tail", None, tail))
                    meta.append((None, -1))
                return steps, meta

        return steps, meta

    def _urmrefm_lookup(name):
        try:
            return renpy.game.script.lookup(name)
        except BaseException:
            return None

    def _urmrefm_pyjump(node):
        """('jump'|'call', label) for a python line that only does that."""

        try:
            lines = [l.strip() for l in node.code.source.split("\n")
                     if l.strip() and not l.strip().startswith("#")]
        except Exception:
            return None

        for line in lines:
            if line[:1] in (" ", "\t"):
                continue
            m = _URMREFM_PYJUMP.match(line)
            if m:
                return m.group(1), m.group(2)

        return None

    def _urmrefm_after(node):
        """The statement that runs after this one, ignoring its inside."""

        return getattr(node, "next", None)

    def _urmrefm_successors(node):
        """Every statement control can reach next - for the meeting point."""

        key = id(node)
        hit = _urmrefm_st.succ.get(key)
        if hit is None:
            hit = _urmrefm_successors_of(node)
            _urmrefm_st.succ[key] = hit
        return hit

    def _urmrefm_successors_of(node):

        out = python_list()

        if isinstance(node, renpy.ast.Jump):
            if not getattr(node, "expression", False):
                out.append(_urmrefm_lookup(node.target))
        elif isinstance(node, renpy.ast.Call):
            if not getattr(node, "expression", False):
                out.append(_urmrefm_lookup(node.label))
            out.append(_urmrefm_after(node))
        elif isinstance(node, renpy.ast.Return):
            pass
        elif isinstance(node, renpy.ast.Menu):
            for item in (getattr(node, "items", None) or []):
                block = item[2]
                if block is None:
                    continue
                out.append(block[0] if block else _urmrefm_after(node))
        elif isinstance(node, renpy.ast.If):
            exhaustive = False
            for cond, block in (getattr(node, "entries", None) or []):
                out.append(block[0] if block else _urmrefm_after(node))
                if not _urmref_is_condition(cond):
                    exhaustive = True
            if not exhaustive:
                out.append(_urmrefm_after(node))
        elif isinstance(node, renpy.ast.While):
            block = getattr(node, "block", None)
            if block:
                out.append(block[0])
            out.append(_urmrefm_after(node))
        elif isinstance(node, renpy.ast.Python):
            hop = _urmrefm_pyjump(node)
            if hop:
                out.append(_urmrefm_lookup(hop[1]))
                if hop[0] == "call":
                    out.append(_urmrefm_after(node))
            else:
                out.append(_urmrefm_after(node))
        else:
            out.append(_urmrefm_after(node))

        return tuple(n for n in out if n is not None)

    def _urmrefm_reach(start, menu=None):
        """
        {id: (distance, node)} for what this arm can reach.

        The search does not go through the menu on screen: a wrong turn that
        leads back to it would otherwise reach every other choice's own
        statements, and the nearest of those would be taken as the meeting
        point - hiding that choice's effects entirely.
        """

        seen = python_dict()

        if start is None:
            return seen

        seen[id(start)] = (0, start)
        queue = python_list([start])
        head = 0

        while head < len(queue) and len(seen) < _URMREFM_REACH:
            node = queue[head]
            head += 1
            dist = seen[id(node)][0]
            if menu is not None and node is menu:
                continue
            for nxt in _urmrefm_successors(node):
                if id(nxt) not in seen:
                    seen[id(nxt)] = (dist + 1, nxt)
                    queue.append(nxt)

        return seen

    _URMREFM_CANDIDATES = 12  # rejoin candidates checked exactly, nearest first

    def _urmrefm_region(start, x, menu):
        """
        The ids of what start can reach without passing x, or None when that
        runs on so far it clearly carries on with the story - a path that
        gets past x without going through it. Paths that end, or come back to
        the menu on screen, stay inside: they never rejoin at all.
        """

        seen = python_set()
        if start is None or start is x:
            return seen

        seen.add(id(start))
        queue = python_list([start])

        while queue:
            node = queue.pop()
            if menu is not None and node is menu:
                continue
            for nxt in _urmrefm_successors(node):
                if nxt is x or id(nxt) in seen:
                    continue
                seen.add(id(nxt))
                if len(seen) >= _URMREFM_REACH:
                    return None
                queue.append(nxt)

        return seen

    def _urmrefm_meets(x, menu, regions):
        """
        True if something after x is also in the regions - a path got round
        x to a statement x leads to, so x is not where every path passes.
        """

        if not regions:
            return False

        seen = python_set([id(x)])
        queue = python_list([x])
        head = 0

        while head < len(queue) and len(seen) < _URMREFM_REACH:
            node = queue[head]
            head += 1
            if menu is not None and node is menu:
                continue
            for nxt in _urmrefm_successors(node):
                if id(nxt) in seen:
                    continue
                if id(nxt) in regions:
                    return True
                seen.add(id(nxt))
                queue.append(nxt)

        return False

    def _urmrefm_meeting(starts, menu, after):
        """
        The statement where the arms rejoin, or None.

        That is the first statement every path must pass through - the
        post-dominator - setting aside arms and inner paths that never rejoin
        (an ending, or a wrong turn back to this menu). Candidates are the
        statements reached by the most arms, nearest to the slowest of them,
        and each is checked exactly: with it removed, no path may get past
        it. "Reached by most" alone is wrong when one inner path passes a
        shared label and another goes round it.
        """

        reach = [_urmrefm_reach(s, menu) for s in starts]
        if len(reach) < 2:
            return after

        counts = python_dict()
        for r in reach:
            for key, (dist, node) in r.items():
                c = counts.get(key)
                if c is None:
                    counts[key] = [1, dist, node]
                else:
                    c[0] += 1
                    if dist > c[1]:
                        c[1] = dist

        ranked = python_list()
        for key, (count, worst, node) in counts.items():
            if count < 2 or (menu is not None and node is menu):
                continue
            ranked.append(((-count, worst), node))

        if not ranked:
            return None

        ranked.sort(key=lambda r: r[0])

        for _score, x in ranked[:_URMREFM_CANDIDATES]:
            regions = python_set()
            ok = True
            for start, r in zip(starts, reach):
                if id(x) not in r:
                    continue
                region = _urmrefm_region(start, x, menu)
                if region is None:
                    ok = False
                    break
                regions |= region
            if ok and not _urmrefm_meets(x, menu, regions):
                return x

        return ranked[0][1]

    def _urmrefm_pure(nodes, depth=0):
        """True if this block can only fall through - no jumps or menus."""

        if depth > _URMREF_MAX_DEPTH:
            return False

        for node in (nodes or []):
            if isinstance(node, (renpy.ast.Jump, renpy.ast.Call,
                                 renpy.ast.Return, renpy.ast.Menu,
                                 renpy.ast.While)):
                return False
            if isinstance(node, renpy.ast.Python) and _urmrefm_pyjump(node):
                return False
            if isinstance(node, renpy.ast.If):
                for _c, block in (getattr(node, "entries", None) or []):
                    if not _urmrefm_pure(block, depth + 1):
                        return False
            block = getattr(node, "block", None)
            if isinstance(node, renpy.ast.Label) and block:
                return False

        return True

    def _urmrefm_choice_label(item):

        text = _URMREFM_TAG.sub(u"", u"%s" % (item[0] or u"")).strip()

        cond = item[1]
        if cond is not None and (u"%s" % cond).strip() not in (u"", u"True"):
            text += u" (if %s)" % _urmref_clip(u"%s" % cond, _URMREF_MAX_GUARD_CHARS)

        return text

    _URMREFM_MARK_CHECK = u"\x00check"

    _URMREFM_MARK_MENU = u"\x00menu"

    def _urmrefm_real(records):
        return python_list(r for r in records if not r[1].startswith(u"\x00"))

    def _urmrefm_target_tag(block):
        """'\x01label' when an if arm ends (or starts) by jumping somewhere, for its title."""
        try:
            for node in (block[-1], block[0]):
                if isinstance(node, renpy.ast.Jump) and not getattr(node, "expression", False):
                    return u"\x01" + node.target
        except Exception:
            pass
        return u""

    def _urmrefm_arm_label(label):
        return label.split(u"\x01")[0]

    def _urmrefm_text_menu(node):
        """A menu whose every option only says something and carries on."""
        try:
            items = [i for i in node.items if i[2] is not None]
            if not items:
                return False
            for i in items:
                if not _urmrefm_pure(i[2]) or _urmref_flatten(i[2]):
                    return False
                if i[1] is not None and (u"%s" % i[1]).strip() not in (u"", u"True"):
                    return False
            return True
        except Exception:
            return False

    class _URMREFMWalk(python_object):
        def __init__(self, stop, menu):
            self.stop = stop
            self.menu = menu
            self.steps = 0
            self.leaves = 0

    def _urmrefm_walk(w, node, stack, seen, depth):
        """
        One path from node to the meeting point, as a segment:
        (records, end) where end is one of
            ("meet",)  ("here",)  ("loop",)  ("return",)  ("limit",)
            ("more", n)  ("fork", [(label, segment), ...])
        records are (guards, text) as _urmref_flatten makes them.
        """

        records = python_list()
        stack = python_list(stack)
        seen = python_set(seen)

        while True:

            if node is None:
                if stack:
                    node = stack.pop()
                    continue
                return records, ("return",)

            if id(node) == w.stop:
                return records, ("meet",)

            if w.menu is not None and node is w.menu:
                return records, ("here",)

            if id(node) in seen:
                return records, ("loop",)

            w.steps += 1
            if w.steps > _URMREFM_STEPS or w.leaves >= _URMREFM_PATHS:
                return records, ("limit",)

            seen.add(id(node))

            if isinstance(node, renpy.ast.Jump):
                if getattr(node, "expression", False):
                    records.append(((), "jump to a computed label"))
                    return records, ("limit",)
                node = _urmrefm_lookup(node.target)
                if node is None:
                    return records, ("limit",)
                continue

            if isinstance(node, renpy.ast.Call):
                if getattr(node, "expression", False):
                    records.append(((), "call a computed label"))
                    node = _urmrefm_after(node)
                    continue
                target = _urmrefm_lookup(node.label)
                if target is None:
                    node = _urmrefm_after(node)
                    continue
                stack.append(_urmrefm_after(node))
                node = target
                continue

            if isinstance(node, renpy.ast.Return):
                if stack:
                    node = stack.pop()
                    continue
                return records, ("return",)

            if isinstance(node, renpy.ast.Python):
                hop = _urmrefm_pyjump(node)
                if hop:
                    target = _urmrefm_lookup(hop[1])
                    if target is None:
                        records.append(((), "%s %s" % hop))
                        return records, ("limit",)
                    if hop[0] == "call":
                        stack.append(_urmrefm_after(node))
                    node = target
                    continue
                for line in _urmref_python_lines(node, [0]):
                    records.append(((), line))
                node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.If) and _urmrefm_pure(
                    [node], 0):
                flat = _urmref_flatten([node])
                # A check that only changes some lines still matters to the
                # map: it is drawn as a mark on its block.
                records.extend(flat if flat else [((), _URMREFM_MARK_CHECK)])
                node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.If):
                arms = python_list()
                exhaustive = False
                for cond, block in (getattr(node, "entries", None) or []):
                    if _urmref_is_condition(cond):
                        label = "if " + _urmref_clip(str(cond), _URMREF_MAX_GUARD_CHARS)
                    else:
                        label = "otherwise"
                        exhaustive = True
                    start = block[0] if block else _urmrefm_after(node)
                    arms.append((label + _urmrefm_target_tag(block), start))
                if not exhaustive:
                    arms.append(("otherwise", _urmrefm_after(node)))
                return records, ("fork", python_list(
                    (label, _urmrefm_walk(w, start, stack, seen, depth))
                    for label, start in arms), "if")

            if isinstance(node, renpy.ast.Menu) and node is not w.menu and _urmrefm_text_menu(node):
                records.append(((), _URMREFM_MARK_MENU))
                node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.Menu):
                items = [i for i in (getattr(node, "items", None) or [])
                         if i[2] is not None]
                if depth >= _URMREFM_DEPTH:
                    return records, ("more", len(items))
                return records, ("fork", python_list(
                    (_urmrefm_choice_label(i),
                     _urmrefm_walk(w, i[2][0] if i[2] else _urmrefm_after(node),
                                stack, seen, depth + 1))
                    for i in items), "menu")

            if isinstance(node, renpy.ast.While):
                records.append(((), "while %s: ..." % _urmref_clip(
                    str(getattr(node, "condition", "")), _URMREF_MAX_GUARD_CHARS)))
                node = _urmrefm_after(node)
                continue

            text = _urmref_statement(node)
            if text is not None:
                records.append(((), text))

            node = _urmrefm_after(node)

    def _urmrefm_plan(menu, blocks):
        """(arm start statements, rejoin statement or None), or None."""

        # The line after the menu: from the menu itself, or else from the end
        # of any arm that falls off its block rather than leaving it.
        after = _urmrefm_after(menu) if menu is not None else None
        if after is None:
            for block in blocks:
                if block and not isinstance(block[-1], (
                        renpy.ast.Jump, renpy.ast.Return)):
                    after = _urmrefm_after(block[-1])
                    if after is not None:
                        break

        starts = python_list()
        for block in blocks:
            if block is None:
                return None
            starts.append(block[0] if block else after)

        return starts, _urmrefm_meeting(starts, menu, after)

    def _urmrefm_arms(menu, blocks, plan=None):
        """One walked segment per choice, or None if the menu can't be read."""

        if plan is None:
            plan = _urmrefm_plan(menu, blocks)
        if plan is None:
            return None

        starts, stop = plan
        w = _URMREFMWalk(id(stop) if stop is not None else None, menu)

        arms = python_list()
        for start in starts:
            arms.append(_urmrefm_walk(w, start, (), (), 0))
        return arms

    def _urmrefm_distances(start):
        """{id: distance} for statements that can run after start."""

        seen = python_dict()
        if start is None:
            return seen

        seen[id(start)] = 0
        queue = python_list([start])
        head = 0

        while head < len(queue) and len(seen) < _URMREFM_LATER:
            node = queue[head]
            head += 1
            dist = seen[id(node)]
            for nxt in _urmrefm_successors(node):
                if id(nxt) not in seen:
                    seen[id(nxt)] = dist + 1
                    queue.append(nxt)

        return seen

    def _urmrefm_next_menu(start, limit=3000):
        """
        The nearest menu at or ahead of start. An if is only pruned when its
        condition can be judged now; otherwise every arm is searched.
        """

        if start is None:
            return None

        seen = python_set([id(start)])
        queue = python_list([start])
        head = 0

        while head < len(queue) and head < limit:
            node = queue[head]
            head += 1

            if isinstance(node, renpy.ast.Menu):
                return node

            if isinstance(node, renpy.ast.If):
                nexts = python_list()
                taken = False
                for cond, block in (getattr(node, "entries", None) or []):
                    target = block[0] if block else _urmrefm_after(node)
                    truth = True if not _urmref_is_condition(cond) else _urmref_truth(cond)
                    if truth is False:
                        continue
                    nexts.append(target)
                    if truth is True:
                        taken = True
                        break
                if not taken:
                    nexts.append(_urmrefm_after(node))
            else:
                nexts = _urmrefm_successors(node)

            for nxt in nexts:
                if nxt is not None and id(nxt) not in seen:
                    seen.add(id(nxt))
                    queue.append(nxt)

        return None

    def _urmrefm_stretch(start, budget=_URMREFM_STRETCH):
        """
        From start to the next real split: ([(label or None, records)],
        split node or None, how it ended). Called labels do not start a
        block; only labels the story passes into do.
        """

        blocks = python_list([[None, python_list()]])
        stack = python_list()
        seen = python_set()
        node = start
        steps = 0

        while True:
            if node is None:
                if stack:
                    node = stack.pop()
                    continue
                return blocks, None, "return"
            if id(node) in seen:
                return blocks, None, "loop"
            steps += 1
            if steps > budget:
                return blocks, None, "limit"
            seen.add(id(node))

            if isinstance(node, renpy.ast.Label) and not stack:
                if blocks[-1][0] is None and not blocks[-1][1]:
                    blocks[-1][0] = node.name
                else:
                    blocks.append([node.name, python_list()])
                node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.Jump):
                if getattr(node, "expression", False):
                    return blocks, None, "limit"
                node = _urmrefm_lookup(node.target)
                if node is None:
                    return blocks, None, "limit"
                continue

            if isinstance(node, renpy.ast.Call):
                target = None if getattr(node, "expression", False) else _urmrefm_lookup(node.label)
                if target is not None:
                    stack.append(_urmrefm_after(node))
                    node = target
                else:
                    node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.Return):
                if stack:
                    node = stack.pop()
                    continue
                return blocks, None, "return"

            if isinstance(node, renpy.ast.Python):
                hop = _urmrefm_pyjump(node)
                if hop:
                    target = _urmrefm_lookup(hop[1])
                    if target is None:
                        return blocks, None, "limit"
                    if hop[0] == "call":
                        stack.append(_urmrefm_after(node))
                    node = target
                    continue
                for line in _urmref_python_lines(node, [0]):
                    blocks[-1][1].append(((), line))
                node = _urmrefm_after(node)
                continue

            if isinstance(node, renpy.ast.If):
                if _urmrefm_pure([node], 0):
                    flat = _urmref_flatten([node])
                    blocks[-1][1].extend(flat if flat else [((), _URMREFM_MARK_CHECK)])
                    node = _urmrefm_after(node)
                    continue
                return blocks, node, None

            if isinstance(node, renpy.ast.Menu):
                if _urmrefm_text_menu(node):
                    blocks[-1][1].append(((), _URMREFM_MARK_MENU))
                    node = _urmrefm_after(node)
                    continue
                return blocks, node, None

            text = _urmref_statement(node)
            if text is not None:
                blocks[-1][1].append(((), text))
            node = _urmrefm_after(node)

    def _urmrefs_lookup(name):
        try:
            return renpy.game.script.lookup(name)
        except Exception:
            return None

    def _urmrefs_next(node):
        """The statement that runs after `node`, or None where it cannot be told."""

        ast = renpy.ast
        if isinstance(node, ast.Translate):
            return node.block[0] if node.block else node.next
        if isinstance(node, ast.Jump):
            if getattr(node, "expression", False):
                return None
            return _urmrefs_lookup(node.target)
        if isinstance(node, ast.Call):
            if getattr(node, "expression", False):
                return None
            return _urmrefs_lookup(node.label)
        if isinstance(node, (ast.Menu, ast.Return, ast.While)):
            return None
        if isinstance(node, ast.If):
            # Which branch runs does not matter when none of them has dialogue
            # or a choice - and then nothing needs evaluating.
            if _urmrefs_quiet_if(node):
                return node.next
            for cond, block in node.entries:
                try:
                    taken = renpy.python.py_eval(cond)
                except Exception:
                    return None
                if taken:
                    return block[0] if block else node.next
            return node.next
        if isinstance(node, ast.Label):
            return node.block[0] if getattr(node, "block", None) else node.next
        return getattr(node, "next", None)

    def _urmrefs_passes(node):
        ast = renpy.ast
        kinds = python_list()
        for name in ("If", "Translate", "EndTranslate", "Show", "Scene", "Hide", "With", "Python",
                     "Pass", "UserStatement", "ShowLayer", "Camera"):
            cls = getattr(ast, name, None)
            if cls is not None:
                kinds.append(cls)
        return isinstance(node, tuple(kinds))

    def _urmrefs_quiet_if(node, depth=0):
        """An if whose branches only change pictures, sound or values - no dialogue, no choice."""

        ast = renpy.ast
        if depth > 4:
            return False
        for _cond, block in node.entries:
            for child in block or ():
                if isinstance(child, (ast.Say, ast.Menu, ast.Jump, ast.Call, ast.Return)):
                    return False
                if isinstance(child, ast.If) and not _urmrefs_quiet_if(child, depth + 1):
                    return False
                if isinstance(child, ast.Translate):
                    return False
        return True

    def _urmrefs_says_in(block, depth=0):
        """Every dialogue line directly in a block (and in ifs inside it)."""

        ast = renpy.ast
        out = python_list()
        if depth > 4:
            return out
        for child in block or ():
            if isinstance(child, ast.Say):
                out.append(child)
            elif isinstance(child, ast.Translate):
                for inner in child.block or ():
                    if isinstance(inner, ast.Say):
                        out.append(inner)
            elif isinstance(child, ast.If):
                for _c, sub in child.entries:
                    out.extend(_urmrefs_says_in(sub, depth + 1))
        return out
